<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="com.rays.user.MarksheetDTO" table="st_marksheet">

        <id name="id" type="int">
            <column name="ID"/>
            <generator class="increment"/>
        </id>

        <property name="name" type="string">
            <column name="NAME"/>
        </property>

        <property name="rollNo" type="string">
            <column name="ROLLNO"/>
        </property>

        <property name="physics" type="int">
            <column name="PHYSICS"/>
        </property>

        <property name="chemistry" type="int">
            <column name="CHEMISTRY"/>
        </property>

        <property name="maths" type="int">
            <column name="MATHS"/>
        </property>

    </class>

</hibernate-mapping>